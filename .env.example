# ---------------------------------------------------------------------------
# Grilly Cheese - vending outreach automation
#
# LOCAL: copy to `.env` and fill in. `.env` is gitignored.
# REPLIT: do not use this file. Put each name below into Tools > Secrets;
#         they arrive as ordinary environment variables.
# ---------------------------------------------------------------------------

# --- State ----------------------------------------------------------------
# Replit provides this when you add a PostgreSQL database to the Repl.
# REQUIRED on Replit: Scheduled Deployments wipe the filesystem between runs,
# so a SQLite file would forget who was already contacted and email them again.
# Leave unset locally to use data/outreach.sqlite3.
DATABASE_URL=

# --- Discovery ------------------------------------------------------------
# Google Cloud key with "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=

# --- Gmail + Calendar -----------------------------------------------------
# Replit is headless, so the browser OAuth flow cannot run there. Mint these
# once on your laptop with `python -m vending_outreach auth`, then paste all
# three into Replit Secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Mailbox outreach is sent from.
SENDER_EMAIL=grillycheese@grillycheese.net

# --- CRM (primary) --------------------------------------------------------
# The Replit-hosted CRM that sits alongside grillycheese.net.
CRM_BASE_URL=
CRM_API_TOKEN=

# --- HubSpot (secondary, contacts only) -----------------------------------
# Optional. Leave blank to skip the contact mirror entirely.
HUBSPOT_ACCESS_TOKEN=

# --- Local-only OAuth fallback -------------------------------------------
# Used by `auth`, and by local runs that prefer a cached token file.
GOOGLE_OAUTH_CLIENT_SECRETS=./secrets/google_client_secret.json
GOOGLE_OAUTH_TOKEN_CACHE=./secrets/google_token.json
