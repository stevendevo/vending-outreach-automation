# ---------------------------------------------------------------------------
# Grilly Cheese - vending outreach automation
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# Google Places API (New) key -- used for apartment/property discovery.
# Enable "Places API (New)" in Google Cloud console.
GOOGLE_PLACES_API_KEY=

# HubSpot private app token. Scopes needed:
#   crm.objects.companies.read/write, crm.objects.contacts.read/write,
#   crm.objects.deals.read/write, crm.objects.owners.read
HUBSPOT_ACCESS_TOKEN=

# Google OAuth client for Gmail + Calendar (installed-app / desktop client).
# Download the client JSON and point at it here. Token cache is written next to it.
GOOGLE_OAUTH_CLIENT_SECRETS=./secrets/google_client_secret.json
GOOGLE_OAUTH_TOKEN_CACHE=./secrets/google_token.json

# Mailbox the outreach is sent from.
SENDER_EMAIL=grillycheese@grillycheese.net
